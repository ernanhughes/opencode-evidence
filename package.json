{
  "name": "opencode-evidence",
  "version": "0.1.0",
  "description": "OpenCode plugin that captures observable tool/file/command/test/HTTP/git state as normalized, provenance-bearing EvidenceRecords. Observation only — no verification, no proof.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "evidence.example.json",
    "README.md",
    "DESIGN.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format esm --packages external",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "health": "bun src/dev-cli.ts health",
    "smoke": "bun src/dev-cli.ts smoke",
    "load-check": "bun src/dev-cli.ts load"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.22"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0"
}
